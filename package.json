{
  "name": "astro-theme-awesomeness",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "turbo run start",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:astro",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "clean": "turbo run clean && rm -rf node_modules",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "fallow": "fallow",
    "fallow:dead": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score",
    "fallow:audit": "fallow audit --base main",
    "prepare": "husky",
    "lint:astro": "node --import=./scripts/astro-check-typescript.mjs --experimental-strip-types scripts/lint-astro.mjs",
    "test:lint": "node --import=./scripts/astro-check-typescript.mjs --experimental-strip-types --test scripts/lint-astro.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@shadcn/lint": "0.1.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript/typescript6": "^6.0.2",
    "astro-eslint-parser": "^3.1.0",
    "eslint": "^10.10.0",
    "fallow": "^3.24.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-config-awesomeness": "^4.5.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "oxlint-tsgolint": "^7.0.2001",
    "tsdown": "^0.23.0",
    "turbo": "^2.10.12",
    "tw-animate-css": "^1.4.0"
  },
  "lint-staged": {
    "!(*.d).{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint"
    ],
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs,json,md}": [
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
