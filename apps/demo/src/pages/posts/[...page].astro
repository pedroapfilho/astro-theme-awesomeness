---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ListLayout from "../../components/list-layout.astro";
import { content } from "../../lib/content";
import { PAGE_SIZE } from "../../lib/site";

export const getStaticPaths = (({ paginate }) =>
  paginate(content.posts, { pageSize: PAGE_SIZE })) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page }: Props = Astro.props;
---
<ListLayout title="All posts" description="Every story, starting with the latest." page={page} />
