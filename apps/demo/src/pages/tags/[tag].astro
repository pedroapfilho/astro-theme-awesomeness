---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { lib } from "astro-awesomeness";
import { notDraft } from "astro-awesomeness/content";
import ListLayout from "astro-awesomeness/layouts/list-layout";
import "../../styles/global.css";

export const getStaticPaths = async () => {
  const posts = await getCollection("posts", notDraft);
  const tagSet = new Set<string>();
  for (const post of posts) for (const tag of post.data.tags) tagSet.add(tag);
  return [...tagSet].map((tag) => ({
    params: { tag: lib.slugify(tag) },
    props: {
      tag,
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
};

type Props = { tag: string; posts: Array<CollectionEntry<"posts">> };
const { tag, posts } = Astro.props;
---
<ListLayout
  title={`Tagged "${tag}"`}
  description={`Posts tagged ${tag}.`}
  posts={posts}
  siteTitle="Awesomeness"
  rssHref="/rss.xml"
/>
