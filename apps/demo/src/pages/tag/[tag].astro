---
import type { InferGetStaticPropsType } from "astro";
import ListLayout from "../../components/list-layout.astro";
import { index } from "../../lib/content";

export const getStaticPaths = () => index.tags().map((tag) => ({
  params: { tag: tag.slug },
  props: { tag },
}));

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { tag }: Props = Astro.props;
---
<ListLayout title={`Tagged “${tag.name}”`} description={`Stories about ${tag.name}.`} posts={tag.posts} />
