---
import { lib } from "astro-awesomeness";
import { byPubDateDesc } from "astro-awesomeness/content";
import ListLayout from "astro-awesomeness/layouts/list-layout";
import { getPublishedPosts, type PostEntry } from "../../lib/posts";
import "../../styles/global.css";

export const getStaticPaths = async () => {
  const posts = await getPublishedPosts();
  const tagSet = new Set<string>();
  for (const post of posts) for (const tag of post.data.tags) tagSet.add(tag);
  return [...tagSet].map((tag) => ({
    params: { tag: lib.slugify(tag) },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)).toSorted(byPubDateDesc),
    },
  }));
};

type Props = { tag: string; posts: Array<PostEntry> };
const { tag, posts } = Astro.props;
---
<ListLayout
  title={`Tagged "${tag}"`}
  description={`Posts tagged ${tag}.`}
  posts={posts}
  siteTitle="Awesomeness"
  rssHref="/rss.xml"
/>
