---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import ListLayout from "../../components/list-layout.astro";
import { content } from "../../lib/content";

export const getStaticPaths = (() => content.tags().map((tag) => ({
  params: { tag: tag.slug },
  props: { tag },
}))) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag }: Props = Astro.props;
---
<ListLayout title={`Tagged “${tag.name}”`} description={`Stories about ${tag.name}.`} posts={tag.posts} />
