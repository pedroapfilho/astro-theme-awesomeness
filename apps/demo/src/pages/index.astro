---
import ListLayout from "astro-awesomeness/layouts/list-layout";
import { PAGE_SIZE, urlForPage } from "../lib/pagination";
import { getSortedPosts } from "../lib/posts";
import "../styles/global.css";

const allPosts = await getSortedPosts();
const posts = allPosts.slice(0, PAGE_SIZE);
const lastPage = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const page = lastPage > 1 ? { currentPage: 1, lastPage, url: {} } : undefined;
---
<ListLayout
  title="Notes on building the web"
  description="A reference publication for astro-awesomeness, showing the theme with real hierarchy, long-form rhythm, and code-rich stories."
  eyebrow="ASTRO AWESOMENESS · THEME DEMO"
  posts={posts}
  page={page}
  urlForPage={urlForPage}
  siteTitle="Awesomeness"
  rssHref="/rss.xml"
/>
