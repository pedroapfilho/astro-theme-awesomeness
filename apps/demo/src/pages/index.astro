---
import ListLayout from "../components/list-layout.astro";
import { index } from "../lib/content";
---
<ListLayout
  title="Notes on building the web"
  description="A reference publication for astro-awesomeness, showing the theme with real hierarchy, long-form rhythm, and code-rich stories."
  posts={index.posts.slice(0, 3)}
>
  <a href="/posts/" class="mt-8 inline-block font-medium underline underline-offset-4">Browse all posts</a>
</ListLayout>
