---
import type { GetStaticPathsOptions, Page } from "astro";
import ListLayout from "astro-awesomeness/layouts/list-layout";
import { PAGE_SIZE, urlForPage } from "../../../lib/pagination";
import { getSortedPosts, type PostEntry } from "../../../lib/posts";
import "../../../styles/global.css";

export const getStaticPaths = async ({ paginate }: GetStaticPathsOptions) => {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: PAGE_SIZE }).filter(({ params }) => params.page !== "1");
};

type Props = { page: Page<PostEntry> };
const { page } = Astro.props;
---
<ListLayout
  title="All posts"
  description="Every post on the demo blog."
  posts={page.data}
  page={{ currentPage: page.currentPage, lastPage: page.lastPage, url: {} }}
  urlForPage={urlForPage}
  siteTitle="Awesomeness"
/>
