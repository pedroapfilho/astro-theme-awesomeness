---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Footer from "astro-awesomeness/astro/footer";
import Pagination from "astro-awesomeness/astro/pagination";
import BaseLayout from "astro-awesomeness/layouts/base-layout";
import PostCard from "./post-card.astro";
import SiteHeader from "./site-header.astro";
import "../styles/global.css";

type Props = {
  description: string;
  page?: Page<CollectionEntry<"posts">>;
  posts: Array<CollectionEntry<"posts">>;
  title: string;
};
const { description, page, posts, title } = Astro.props;
---
<BaseLayout siteTitle="Awesomeness" title={title} description={description} rssHref="/rss.xml">
  <SiteHeader slot="header" />
  <main id="main-content" class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <header class="mb-12">
      <h1 class="max-w-3xl font-serif text-4xl font-semibold tracking-tight sm:text-6xl">{title}</h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-lg text-pretty">{description}</p>
    </header>
    <section aria-label="Posts">
      {posts.map((post) => <PostCard post={post} />)}
    </section>
    {page && <Pagination page={page} />}
    <slot />
  </main>
  <Footer slot="footer" siteTitle="Awesomeness" />
</BaseLayout>
