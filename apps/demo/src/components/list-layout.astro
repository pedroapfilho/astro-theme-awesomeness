---
import type { Page } from "astro";
import type { CollectionEntry } from "astro:content";
import Pagination from "astro-awesomeness/astro/pagination";
import PostCard from "./post-card.astro";
import SiteLayout from "./site-layout.astro";

type Post = CollectionEntry<"posts">;

type Props = { description: string; title: string } & (
  | { page: Page<Post> }
  | { posts: Array<Post> }
);

const { description, title } = Astro.props;

const { page, posts } =
  "page" in Astro.props
    ? { page: Astro.props.page, posts: Astro.props.page.data }
    : { page: undefined, posts: Astro.props.posts };
---
<SiteLayout title={title} description={description}>
  <main id="main-content" class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <header class="mb-12">
      <h1 class="max-w-3xl font-serif text-4xl font-semibold tracking-tight sm:text-6xl">{title}</h1>
      <p class="text-muted-foreground mt-5 max-w-2xl text-lg text-pretty">{description}</p>
    </header>
    <section aria-label="Posts">
      {posts.map((post) => <PostCard post={post} />)}
    </section>
    {page && <Pagination page={page} />}
    <slot />
  </main>
</SiteLayout>
