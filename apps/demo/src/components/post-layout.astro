---
import type { CollectionEntry } from "astro:content";
import AuthorByline from "astro-awesomeness/astro/author-byline";
import AuthorCard from "astro-awesomeness/astro/author-card";
import Footer from "astro-awesomeness/astro/footer";
import FormattedDate from "astro-awesomeness/astro/formatted-date";
import Prose from "astro-awesomeness/astro/prose";
import ReadingTime from "astro-awesomeness/astro/reading-time";
import TagList from "astro-awesomeness/astro/tag-list";
import BaseLayout from "astro-awesomeness/layouts/base-layout";
import { index } from "../lib/content";
import PostCard from "./post-card.astro";
import SiteHeader from "./site-header.astro";
import "../styles/global.css";

type Post = CollectionEntry<"posts">;
type Props = { post: Post; relatedPosts: Array<Post> };
const { post, relatedPosts } = Astro.props;
const { author, description, pubDate, tags, title, updatedDate } = post.data;
const category = index.postCategory(post);
---
<BaseLayout siteTitle="Awesomeness" post={post} rssHref="/rss.xml">
  <SiteHeader slot="header" />
  <main id="main-content" class="mx-auto max-w-5xl px-5 py-12 sm:px-8 sm:py-16">
    <article>
      <header class="border-border mb-10 border-b pb-8">
        <a href={category.href} class="text-muted-foreground text-sm hover:underline">{category.name}</a>
        <h1 class="mt-4 max-w-3xl font-serif text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
        <p class="text-muted-foreground mt-5 max-w-2xl text-lg text-pretty">{description}</p>
        <div class="text-muted-foreground mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 text-sm">
          {author && <AuthorByline author={author} />}
          <FormattedDate date={pubDate} />
          <ReadingTime text={post.body ?? ""} />
          {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
        </div>
        {tags.length > 0 && <TagList tags={tags} class="mt-5" />}
      </header>
      <Prose><slot /></Prose>
      {author && <AuthorCard author={author} class="mt-10 max-w-2xl" />}
    </article>
    {relatedPosts.length > 0 && (
      <section aria-labelledby="related-posts" class="border-border mt-16 border-t pt-10">
        <h2 id="related-posts" class="mb-8 font-serif text-3xl font-semibold tracking-tight">Keep reading</h2>
        {relatedPosts.map((relatedPost) => <PostCard post={relatedPost} />)}
      </section>
    )}
  </main>
  <Footer slot="footer" siteTitle="Awesomeness" />
</BaseLayout>
