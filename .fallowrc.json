{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "oxlint.config.ts",
    "**/tsdown.config.ts",
    "apps/demo/src/components/{list,post}-layout.astro",
    "packages/blog-snapshot/src/cli.ts"
  ],
  "ignorePatterns": [".github/ci/*.mjs"],
  "ignoreDependencies": [
    "@shadcn/lint",
    "@typescript-eslint/parser",
    "@typescript/typescript6",
    "@vitest/coverage-v8",
    "astro-eslint-parser"
  ],
  "typeAware": {
    "enabled": true,
    "require": "best-effort"
  },
  "rules": {
    "private-type-leaks": "off"
  },
  "boundaries": {
    "zones": [
      {
        "name": "app",
        "autoDiscover": ["apps"]
      },
      {
        "name": "package",
        "patterns": ["packages/**"]
      }
    ],
    "rules": [
      {
        "from": "package",
        "allow": ["package"]
      },
      {
        "from": "app",
        "allow": ["package"]
      }
    ]
  }
}
