{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Astro",
  "extends": "./base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "astro",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "module": "ESNext",
    "noEmit": true,
    "types": ["astro/client"]
  }
}
