---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import PostLayout from "virtual:astro-awesomeness/components/PostLayout";
import { content } from "virtual:astro-awesomeness/content";

export const getStaticPaths = (() => content.posts.map((post) => ({
  params: content.postParams(post),
  props: { post },
}))) satisfies GetStaticPaths;

const { post } = Astro.props;
const { Content } = await render(post);
---
<PostLayout post={post}>
  <Content />
</PostLayout>
