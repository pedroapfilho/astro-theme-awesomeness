---
import { ThemeToggle } from "../components/theme-toggle";
import { cn } from "../lib/cn";

type Props = {
  siteTitle: string;
  homeHref?: string;
  class?: string;
  themeToggleLabel?: string;
  showThemeToggle?: boolean;
};

const {
  siteTitle,
  homeHref = "/",
  class: className = "",
  themeToggleLabel = "Toggle theme",
  showThemeToggle = true,
} = Astro.props;
---
<header class={cn("border-border bg-background/80 sticky top-0 z-40 border-b backdrop-blur", className)}>
  <div class="mx-auto flex max-w-5xl items-center justify-between px-5 py-4 sm:px-8">
    <a href={homeHref} class="text-foreground font-serif text-lg font-semibold tracking-tight">
      <slot name="brand">{siteTitle}</slot>
    </a>
    <nav class="flex items-center gap-2">
      <slot name="nav" />
      {showThemeToggle && <ThemeToggle client:idle ariaLabel={themeToggleLabel} />}
    </nav>
  </div>
</header>
