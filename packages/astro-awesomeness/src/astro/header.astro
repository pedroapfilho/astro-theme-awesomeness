---
import { ThemeToggle } from "../components/theme-toggle";

type Props = {
  siteTitle: string;
  homeHref?: string;
  class?: string;
  themeToggleLabel?: string;
  showThemeToggle?: boolean;
};

const {
  siteTitle,
  homeHref = "/",
  class: className = "",
  themeToggleLabel = "Toggle theme",
  showThemeToggle = true,
} = Astro.props;
---
<header class:list={["border-border bg-background/80 sticky top-0 z-40 border-b backdrop-blur", className]}>
  <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-3">
    <a href={homeHref} class="text-primary text-base font-semibold tracking-tight">
      <slot name="brand">{siteTitle}</slot>
    </a>
    <nav class="flex items-center gap-2">
      <slot name="nav" />
      {showThemeToggle && <ThemeToggle client:idle ariaLabel={themeToggleLabel} />}
    </nav>
  </div>
</header>
