---
import { Code } from "astro:components";
import { cn } from "../lib/cn";

type Props = {
  class?: string;
  code: string;
  lang?: string;
};

const { class: className = "", code, lang = "ts" } = Astro.props;
---
<div class={cn("bg-muted border-border overflow-hidden rounded-md border", className)}>
  <Code code={code} lang={lang} theme="github-dark" />
</div>
