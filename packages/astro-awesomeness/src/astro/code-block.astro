---
import { Code } from "astro:components";
import { cn } from "../lib/cn";

type Props = {
  code: string;
  lang?: string;
  class?: string;
};

const { code, lang = "ts", class: className = "" } = Astro.props;
---
<div class={cn("bg-muted border-border overflow-hidden rounded-md border", className)}>
  <Code code={code} lang={lang} theme="github-dark" />
</div>
