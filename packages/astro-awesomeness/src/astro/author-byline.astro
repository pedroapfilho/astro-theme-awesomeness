---
import type { Author } from "../content";
import { cn } from "../lib/cn";

type Props = {
  author: Author;
  class?: string;
};

const { author, class: className = "" } = Astro.props;
---
<div class={cn("flex items-center gap-2", className)}>
  {author.photoUrl && (
    <img
      src={author.photoUrl}
      alt={author.name}
      width="28"
      height="28"
      loading="lazy"
      decoding="async"
      class="border-border size-7 rounded-full border object-cover"
    />
  )}
  {author.url ? (
    <a
      href={author.url}
      rel="author"
      class="text-foreground text-sm font-medium hover:underline"
    >
      {author.name}
    </a>
  ) : (
    <span class="text-foreground text-sm font-medium">{author.name}</span>
  )}
</div>
