---
import { cn } from "../lib/cn";

type Props = {
  class?: string;
  currentPage: number;
  lastPage: number;
  nextLabel?: string;
  ofLabel?: string;
  pageLabel?: string;
  prevLabel?: string;
  urlForPage: (page: number) => string;
};

const {
  class: className = "",
  currentPage,
  lastPage,
  nextLabel = "Next →",
  ofLabel = "of",
  pageLabel = "Page",
  prevLabel = "← Previous",
  urlForPage,
} = Astro.props;
const hasPrev = currentPage > 1;
const hasNext = currentPage < lastPage;
---
<nav class={cn("mt-8 flex items-center justify-between", className)} aria-label="Pagination">
  {hasPrev ? (
    <a
      href={urlForPage(currentPage - 1)}
      class="border-border hover:bg-muted inline-flex items-center rounded-md border px-3 py-1.5 text-sm transition-colors"
      rel="prev"
    >
      {prevLabel}
    </a>
  ) : <span aria-hidden="true" />}
  <span class="text-muted-foreground text-sm">
    {pageLabel} {currentPage} {ofLabel} {lastPage}
  </span>
  {hasNext ? (
    <a
      href={urlForPage(currentPage + 1)}
      class="border-border hover:bg-muted inline-flex items-center rounded-md border px-3 py-1.5 text-sm transition-colors"
      rel="next"
    >
      {nextLabel}
    </a>
  ) : <span aria-hidden="true" />}
</nav>
