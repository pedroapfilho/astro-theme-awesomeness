---
import { slugify } from "../lib/slugify";
import { cn } from "../lib/cn";

type Heading = { depth: number; slug: string; text: string };

type Props = {
  class?: string;
  heading?: string;
  headings: Array<{ depth: number; slug?: string; text: string }>;
  maxDepth?: number;
  minDepth?: number;
};

const {
  class: className = "",
  heading = "On this page",
  headings,
  maxDepth = 3,
  minDepth = 2,
} = Astro.props;

const visible: Array<Heading> = headings.flatMap((h) =>
  h.depth >= minDepth && h.depth <= maxDepth
    ? [{ depth: h.depth, slug: h.slug ?? slugify(h.text), text: h.text }]
    : [],
);
---
{visible.length > 0 && (
  <nav class={cn("text-sm", className)} aria-label="Table of contents">
    <p class="text-muted-foreground mb-2 font-medium tracking-wide uppercase">{heading}</p>
    <ul class="space-y-1">
      {visible.map((item) => (
        <li class={cn("leading-snug", item.depth === 3 && "pl-4")}>
          <a
            href={`#${item.slug}`}
            class="text-muted-foreground hover:text-foreground block transition-colors"
          >
            {item.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
