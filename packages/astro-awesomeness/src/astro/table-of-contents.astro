---
import { slugify } from "../lib/slugify";

type Heading = { depth: number; text: string; slug: string };

type Props = {
  headings: Array<{ depth: number; text: string; slug?: string }>;
  minDepth?: number;
  maxDepth?: number;
  class?: string;
};

const { headings, minDepth = 2, maxDepth = 3, class: className = "" } = Astro.props;

const visible: Array<Heading> = headings
  .filter((h) => h.depth >= minDepth && h.depth <= maxDepth)
  .map((h) => ({ depth: h.depth, text: h.text, slug: h.slug ?? slugify(h.text) }));
---
{visible.length > 0 && (
  <nav class:list={["text-sm", className]} aria-label="Table of contents">
    <p class="text-muted-foreground mb-2 font-medium tracking-wide uppercase">On this page</p>
    <ul class="space-y-1">
      {visible.map((heading) => (
        <li class:list={["leading-snug", heading.depth === 3 && "pl-4"]}>
          <a
            href={`#${heading.slug}`}
            class="text-muted-foreground hover:text-foreground block transition-colors"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
