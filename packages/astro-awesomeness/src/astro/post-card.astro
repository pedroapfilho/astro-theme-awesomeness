---
import type { Post } from "../content/index";

import FormattedDate from "./formatted-date.astro";
import TagList from "./tag-list.astro";

type PostEntry = { data: Post; id: string };
type Props = {
  locale?: string;
  post: PostEntry;
  postHref?: (post: PostEntry) => string;
};

const { locale, post, postHref } = Astro.props;
const { description, pubDate, tags, title } = post.data;
const href = postHref ? postHref(post) : `/blog/${post.id}`;
---
<article class="post-card border-border group border-b py-6 last:border-0">
  <a href={href} class="block">
    <h2 class="text-foreground group-hover:text-primary text-xl font-semibold tracking-tight transition-colors">
      {title}
    </h2>
    <div class="text-muted-foreground mt-1 flex items-center gap-2 text-sm">
      <FormattedDate date={pubDate} locale={locale} />
    </div>
    <p class="text-muted-foreground mt-2 line-clamp-2 text-sm">{description}</p>
  </a>
  {tags.length > 0 && <TagList tags={tags} class="mt-3" />}
</article>

<style>
  /* Keep first 3 eager so above-the-fold paint isn't gated on containment checks. */
  .post-card:nth-child(n + 4) {
    content-visibility: auto;
    contain-intrinsic-size: auto 200px;
  }
</style>
