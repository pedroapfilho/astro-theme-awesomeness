---
import { readingMinutes } from "../lib/reading-time";
import { getSiteLocale } from "../lib/site-locale";

type Props = {
  class?: string;
  text: string;
};

const { class: className = "", text } = Astro.props;
const { strings } = getSiteLocale(Astro.currentLocale);
---
<span class={className}>{readingMinutes(text)} {strings.readingTime}</span>
