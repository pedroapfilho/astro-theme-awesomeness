---
import { formatDate } from "../lib/format-date";
import { getSiteLocale } from "../lib/site-locale";

type Props = {
  class?: string;
  date: Date;
};

const { class: className = "", date } = Astro.props;
const { lang } = getSiteLocale(Astro.currentLocale);
const iso = date.toISOString();
const formatted = formatDate(date, lang);
---
<time datetime={iso} class={className}>{formatted}</time>
