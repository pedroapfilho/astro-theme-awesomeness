---
import { formatDate } from "../lib/format-date";

type Props = {
  class?: string;
  date: Date;
  locale?: string;
};

const { class: className = "", date, locale = "en-US" } = Astro.props;
const iso = date.toISOString();
const formatted = formatDate(date, locale);
---
<time datetime={iso} class={className}>{formatted}</time>
