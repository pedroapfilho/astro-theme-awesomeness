---
import type { Post } from "../content/index";

import BaseLayout from "./base-layout.astro";
import Footer from "../astro/footer.astro";
import Header from "../astro/header.astro";
import PostCard from "../astro/post-card.astro";
import Pagination from "../astro/pagination.astro";

type PostEntry = { data: Post; id: string };
type Props = {
  description: string;
  eyebrow?: string;
  locale?: string;
  page?: { currentPage: number; lastPage: number; url: { next?: string; prev?: string } };
  postHref?: (post: PostEntry) => string;
  posts: Array<PostEntry>;
  rssHref?: string;
  siteTitle?: string;
  title: string;
  urlForPage?: (page: number) => string;
};

const {
  description,
  eyebrow,
  locale,
  page,
  postHref,
  posts,
  rssHref,
  siteTitle,
  title,
  urlForPage,
} = Astro.props;
---
<BaseLayout title={title} description={description} siteTitle={siteTitle} rssHref={rssHref}>
  <Fragment slot="header">{siteTitle && <Header siteTitle={siteTitle} />}</Fragment>
  <Fragment slot="footer">{siteTitle && <Footer siteTitle={siteTitle} />}</Fragment>
  <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-5xl px-5 py-12 sm:px-8 sm:py-20">
    <header class="mb-12 grid gap-8 border-b border-border pb-12 md:grid-cols-list-heading md:items-end">
      <div>
        {eyebrow && (
          <p class="text-muted-foreground font-mono text-xs font-semibold tracking-(--tracking-eyebrow)">{eyebrow}</p>
        )}
        <h1 class="text-foreground mt-4 max-w-(--measure-list-title) font-serif text-5xl leading-(--leading-list-title) font-semibold tracking-(--tracking-list-title) sm:text-7xl">
          {title}
        </h1>
      </div>
      <p class="text-muted-foreground max-w-(--measure-list-intro) text-lg text-pretty md:justify-self-end">{description}</p>
    </header>
    <section class="post-grid">
      {posts.map((post) => <PostCard post={post} locale={locale} postHref={postHref} />)}
    </section>
    {page && urlForPage && (
      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        urlForPage={urlForPage}
      />
    )}
  </main>
</BaseLayout>
