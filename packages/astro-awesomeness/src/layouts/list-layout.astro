---
import type { Post } from "../content/index";

import BaseLayout from "./base-layout.astro";
import PostCard from "../astro/post-card.astro";
import Pagination from "../astro/pagination.astro";

type Props = {
  title: string;
  description: string;
  posts: Array<{ slug: string; data: Post }>;
  page?: { currentPage: number; lastPage: number; url: { prev?: string; next?: string } };
  urlForPage?: (page: number) => string;
  locale?: string;
};

const { title, description, posts, page, urlForPage, locale } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <header class="mb-8">
      <h1 class="text-foreground text-3xl font-bold tracking-tight">{title}</h1>
      <p class="text-muted-foreground mt-2">{description}</p>
    </header>
    <section>
      {posts.map((post) => <PostCard post={post} locale={locale} />)}
    </section>
    {page && urlForPage && (
      <Pagination
        currentPage={page.currentPage}
        lastPage={page.lastPage}
        urlForPage={urlForPage}
      />
    )}
  </main>
</BaseLayout>
