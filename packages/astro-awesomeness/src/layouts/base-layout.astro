---
import Seo from "../astro/seo.astro";
import type { MetadataProps } from "../lib/article-metadata";
import { cn } from "../lib/cn";
import { getColorSchemeScript, type ColorScheme } from "../lib/color-scheme";
import { getSiteLocale } from "../lib/site-locale";

type Props = MetadataProps & {
  colorScheme?: ColorScheme;
  rssHref?: string;
};

const { colorScheme = "auto", rssHref, siteTitle } = Astro.props;
const { lang, strings } = getSiteLocale(Astro.currentLocale);
---
<!doctype html>
<html lang={lang} class={cn(colorScheme === "dark" && "dark")}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={colorScheme === "auto" ? "light dark" : colorScheme} />
    <meta name="generator" content={Astro.generator} />
    <Seo {...Astro.props} />
    {rssHref && (
      <link rel="alternate" type="application/rss+xml" title={siteTitle} href={rssHref} />
    )}
    {colorScheme === "auto" && <script is:inline set:html={getColorSchemeScript()} />}
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [
        {
          where: { and: [{ href_matches: "/*" }, { not: { href_matches: "/*\\?*" } }] },
          eagerness: "moderate",
        },
      ],
    })} />
    <slot name="head" />
  </head>
  <body class="bg-background text-foreground min-h-dvh flex flex-col">
    <a
      href="#main-content"
      class="bg-background text-foreground border-border focus:ring-ring sr-only z-50 rounded-md border px-3 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:ring-2"
    >
      {strings.skipLink}
    </a>
    <slot name="header" />
    <div class="flex-1">
      <slot />
    </div>
    <slot name="footer" />
  </body>
</html>
