---
import Footer from "../astro/footer.astro";
import Header from "../astro/header.astro";
import Seo from "../astro/seo.astro";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
  lang?: string;
  siteTitle?: string;
  rssHref?: string;
  siteName?: string;
  locale?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  colorScheme?: "auto" | "light" | "dark";
};

const {
  title,
  description,
  canonical,
  image,
  type = "website",
  lang = "en",
  siteTitle,
  rssHref,
  siteName,
  locale,
  publishedTime,
  modifiedTime,
  colorScheme = "auto",
} = Astro.props;

// Emitted through set:html rather than as literal script children so the two
// branches stay one <script> tag; Astro does not evaluate expressions inside
// script contents.
const colorSchemeScript = colorScheme === "auto"
  ? `(() => {
        const stored = localStorage.getItem("theme");
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored === "dark" || stored === "light" ? stored : prefersDark ? "dark" : "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
      })();`
  : `document.documentElement.classList.toggle("dark", ${colorScheme === "dark"});`;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      type={type}
      siteName={siteName ?? siteTitle}
      locale={locale}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
    />
    {rssHref && (
      <link rel="alternate" type="application/rss+xml" title={siteTitle ?? title} href={rssHref} />
    )}
    <script is:inline set:html={colorSchemeScript} />
    <script type="speculationrules" is:inline set:html={JSON.stringify({
      prefetch: [
        {
          where: { and: [{ href_matches: "/*" }, { not: { href_matches: "/*\\?*" } }] },
          eagerness: "moderate",
        },
      ],
    })} />
    <slot name="head" />
  </head>
  <body class="bg-background text-foreground min-h-dvh flex flex-col">
    <a
      href="#main-content"
      class="bg-background text-foreground border-border focus:ring-ring sr-only z-50 rounded-md border px-3 py-2 focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:ring-2"
    >
      Skip to content
    </a>
    {siteTitle && <Header siteTitle={siteTitle} />}
    <div class="flex-1">
      <slot />
    </div>
    {siteTitle && <Footer siteTitle={siteTitle} />}
  </body>
</html>
